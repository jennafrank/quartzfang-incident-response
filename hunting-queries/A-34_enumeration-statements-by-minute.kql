// A-34: Enumeration statements by minute (R-05)
// Supports: R-05, AH-9 · Captures: CAP-59
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
Syslog
| where Computer =~ "sc-db01"
| where TimeGenerated between (datetime(2026-09-19T00:00:00Z) .. datetime(2026-09-20T09:30:00Z))
| where SyslogMessage has "statement:" and SyslogMessage has_any ("SELECT *", "pg_shadow",
    "information_schema")
| summarize Rows=count(), Distinct=dcount(SyslogMessage) by bin(TimeGenerated, 1m)
| sort by TimeGenerated asc
