// A-43: Baseline sessions without application_name, 04:25 to 04:55
// Supports: F5 · Captures: CAP-81 to CAP-83
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
Syslog
| where Computer =~ "sc-db01"
| where TimeGenerated between (datetime(2026-09-20T04:25:00Z) .. datetime(2026-09-20T04:55:00Z))
| where SyslogMessage has_any ("connection authorized", "statement:")
| project TimeGenerated, SyslogMessage
| distinct * | sort by TimeGenerated asc
