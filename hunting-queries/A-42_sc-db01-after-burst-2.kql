// A-42: sc-db01 after burst 2 (N-12)
// Supports: F5, N-12 · Captures: CAP-74 to CAP-80
// Copied as printed in Appendix A of the v5.0 report; only line wrapping follows the PDF.
Syslog
| where Computer =~ "sc-db01"
| where TimeGenerated between (datetime(2026-09-20T07:46:00Z) .. datetime(2026-09-20T09:30:00Z))
| where SyslogMessage has_any ("connection authorized", "statement:")
| project TimeGenerated, SyslogMessage
| distinct * | sort by TimeGenerated asc
