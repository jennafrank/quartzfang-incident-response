// A-49: All admin API requests from the portal, no user filter (AH-7)
// Supports: AH-7 · Captures: CAP-91
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF. The v5.0 report does not print this query and points readers to this folder.
Syslog
| where Computer =~ "sc-admin01" and ProcessName == "admin_api"
| where TimeGenerated between (datetime(2026-09-20T06:52:00Z) .. datetime(2026-09-20T09:30:00Z))
| where SyslogMessage has "src=10.5.0.10"
| project TimeGenerated, SyslogMessage
| distinct * | sort by TimeGenerated asc
