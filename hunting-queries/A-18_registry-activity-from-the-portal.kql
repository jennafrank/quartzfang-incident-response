// A-18: Registry activity from the portal (N-05)
// Supports: F6, N-05 · Captures: CAP-39
// Copied as printed in Appendix A of the v5.0 report; only line wrapping follows the PDF.
ContainerRegistryLog_CL
| where RunId == "qf-121-20260920"
| where TimeGenerated between (datetime(2026-09-20T07:00:00Z) .. datetime(2026-09-20T09:30:00Z))
| where SrcIpAddr == "10.5.0.10"
| project TimeGenerated, Username, Operation, Resource
| distinct * | sort by TimeGenerated asc
