// A-30: authorized_keys on any device (N-10)
// Supports: F9, N-10 · Captures: CAP-54
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF. The v5.0 report does not print this query and points readers to this folder.
DeviceFileEvents_CL
| where isempty(RunId)
| where Timestamp between (datetime(2026-09-20T06:52:00Z) .. datetime(2026-09-20T09:30:00Z))
| where FileName =~ "authorized_keys" or FolderPath has "authorized_keys"
| project Timestamp, DeviceName, ActionType, FolderPath, InitiatingProcessFileName
