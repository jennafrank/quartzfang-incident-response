// A-04: The shell and everything it ran
// Supports: F3, F4, F8, F10 · Captures: CAP-07
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
DeviceProcessEvents_CL
| where isempty(RunId) and DeviceName =~ "sc-portal01"
| where Timestamp between (datetime(2026-09-20T06:52:00Z) .. datetime(2026-09-20T09:30:00Z))
| where ProcessId == 4401 or InitiatingProcessId == 4401
| project Timestamp, AccountName, FileName, ProcessCommandLine, ProcessId,
    InitiatingProcessFileName, InitiatingProcessId
| distinct * | sort by Timestamp asc
