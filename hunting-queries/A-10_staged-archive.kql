// A-10: Staged archive
// Supports: F8 · Captures: CAP-22 to CAP-23
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
DeviceFileEvents_CL
| where isempty(RunId) and DeviceName =~ "sc-portal01"
| where Timestamp between (datetime(2026-09-20T07:00:00Z) .. datetime(2026-09-20T08:20:00Z))
| where FolderPath has ".portal-cache"
| project Timestamp, ActionType, FileName, FolderPath, InitiatingProcessFileName | distinct *
