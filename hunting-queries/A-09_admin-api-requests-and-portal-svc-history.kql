// A-09: Admin API requests and portal_svc history
// Supports: F7, AH-4 · Captures: CAP-20 to CAP-21
// Copied as printed in Appendix A of the v5.0 report; only line wrapping follows the PDF.
Syslog
| where Computer =~ "sc-admin01" and ProcessName == "admin_api"
| where TimeGenerated between (datetime(2026-09-18T00:00:00Z) .. datetime(2026-09-20T09:00:00Z))
| where SyslogMessage has "portal_svc"
| project TimeGenerated, SyslogMessage | distinct * | sort by TimeGenerated asc
