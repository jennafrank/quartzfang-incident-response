// A-15: Shell external destinations (N-01)
// Supports: N-01 · Captures: CAP-36
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
DeviceNetworkEvents_CL
| where isempty(RunId) and DeviceName =~ "sc-portal01"
| where Timestamp between (datetime(2026-09-20T06:40:00Z) .. datetime(2026-09-20T09:30:00Z))
| where InitiatingProcessId in (4400, 4401, 4430)
| where not(RemoteIP startswith "10.5.")
| project Timestamp, InitiatingProcessId, InitiatingProcessFileName, RemoteIP, RemotePort
| distinct * | sort by Timestamp asc
