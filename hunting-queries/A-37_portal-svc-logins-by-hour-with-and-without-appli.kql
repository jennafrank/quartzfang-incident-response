// A-37: portal_svc logins by hour, with and without application_name
// Supports: F5, C-D4 · Captures: CAP-64 to CAP-67
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
Syslog
| where Computer =~ "sc-db01"
| where TimeGenerated between (datetime(2026-09-19T00:00:00Z) .. datetime(2026-09-20T09:30:00Z))
| where SyslogMessage has "connection authorized" and SyslogMessage has "portal_svc"
| extend app = extract(@"application_name=(\S+)", 1, SyslogMessage), client = extract(@"host=(\S+)", 1,
    SyslogMessage)
| summarize Logins=count(), Distinct=dcount(SyslogMessage) by bin(TimeGenerated, 1h), app, client
| sort by TimeGenerated asc
