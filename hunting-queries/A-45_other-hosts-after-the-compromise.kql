// A-45: Other hosts after the compromise (N-13)
// Supports: N-13 · Captures: CAP-85
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
union DeviceProcessEvents_CL, DeviceEvents_CL, DeviceFileEvents_CL
| where isempty(RunId)
| where DeviceName in~ ("sc-db01", "sc-registry01", "sc-admin01")
| where Timestamp between (datetime(2026-09-20T06:52:00Z) .. datetime(2026-09-20T09:30:00Z))
| summarize Rows=count(), Actions=make_set(ActionType, 10), Files=make_set(FileName, 15),
    Accounts=make_set(AccountName, 10) by Type, DeviceName
