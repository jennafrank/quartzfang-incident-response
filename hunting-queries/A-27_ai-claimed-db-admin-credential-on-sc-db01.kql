// A-27: AI-claimed db_admin credential on sc-db01 (N-11)
// Supports: F10, N-11 · Captures: CAP-51
// Copied as printed in Appendix A of the v5.0 report; only line wrapping follows the PDF.
Syslog
| where Computer =~ "sc-db01"
| where TimeGenerated between (datetime(2026-09-19T00:00:00Z) .. datetime(2026-09-20T09:30:00Z))
| where SyslogMessage has "db_admin"
| project TimeGenerated, SyslogMessage
