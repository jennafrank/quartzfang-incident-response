// A-32: SSH logons in the entry window (N-06)
// Supports: N-06, AH-2 · Captures: CAP-56 to CAP-57
// Copied as printed in Appendix A of the v4.0 report; only line wrapping follows the PDF.
DeviceLogonEvents_CL
| where isempty(RunId)
| where Timestamp between (datetime(2026-09-20T06:00:00Z) .. datetime(2026-09-20T06:53:00Z))
| project Timestamp, DeviceName, AccountName, ActionType, LogonType, RemoteIP
| distinct * | sort by Timestamp asc
