// C-D2 cron-parented python with socket and shell-spawn markers (T1053.003, T1059.006)
// Copied as printed in Appendix C of the v4.0 report. The printed rule carries no backtest time bounds or RunId filter.
// Production schedule from the report: every 5 minutes over a 10-minute lookback.
DeviceProcessEvents_CL
| where FileName in~ ("python3", "python")
| where InitiatingProcessFileName in~ ("cron", "CRON")
| where ProcessCommandLine has "socket"
    and ProcessCommandLine has_any ("subprocess", "dup2", "/bin/sh", "/bin/bash")
| project Timestamp, DeviceName, AccountName, ProcessCommandLine, ProcessId, InitiatingProcessId
