// C-D1 server-side fetch to a non-http(s) scheme or loopback/link-local target (T1190)
// Copied as printed in Appendix C of the v5.0 report. The printed rule carries no backtest time bounds or RunId filter.
// Production schedule from the report: every 5 minutes over a 10-minute lookback.
PortalAccessLog_CL
| where UrlOriginal has "/api/v1/preview"
| extend target = tostring(extract(@"url=([^&]+)", 1, UrlOriginal))
| extend scheme = tostring(extract(@"^([a-zA-Z]+):", 1, target))
| where (isnotempty(scheme) and scheme !in ("http", "https"))
    or target has_any ("127.0.0.1", "localhost", "169.254.")
| summarize Requests=dcount(strcat(TimeGenerated, UrlOriginal)), Schemes=make_set(scheme),
    First=min(TimeGenerated) by SrcIpAddr
